rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check subscription tier
    function hasProSubscription(userId) {
      return exists(/databases/$(database)/documents/subscriptions/$(userId)) &&
             get(/databases/$(database)/documents/subscriptions/$(userId)).data.status == 'active' &&
             get(/databases/$(database)/documents/subscriptions/$(userId)).data.tier in ['pro', 'pyme'];
    }
    
    // User profiles - read/write own profile only
    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Subscriptions - read own subscription, no direct writes (handled by Cloud Functions)
    match /subscriptions/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if false; // Only Cloud Functions can write subscriptions
    }
    
    // Inventory - Pro/Pyme users can read/write their own data
    match /inventory/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Sales - Pro/Pyme users can read/write their own data
    match /sales/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Suppliers - Pro/Pyme users can read/write their own data
    match /suppliers/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Clients - Pro/Pyme users can read/write their own data
    match /clients/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Purchase Orders - Pro/Pyme users can read/write their own data
    match /purchaseOrders/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Arqueo Sessions - Pro/Pyme users can read/write their own invoice sessions
    match /arqueoSessions/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId) && hasProSubscription(userId);
    }
    
    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}