# Gemini API Key - Obtener de: https://aistudio.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# Stripe Secret Key - Obtener de: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret - Obtener de: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs - Obtener de: https://dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id_here
STRIPE_PYME_PRICE_ID=price_your_pyme_plan_id_here

# Notas:
# - Para producción, usar claves con prefijo sk_live_ en lugar de sk_test_
# - El webhook secret se genera al crear un nuevo endpoint de webhook en Stripe
# - URL del webhook debería ser: https://us-central1-easyinventary-d8dbd.cloudfunctions.net/stripeWebhook
# - O si usas Firebase Hosting: https://easyinventary-d8dbd.web.app/api/stripeWebhook
