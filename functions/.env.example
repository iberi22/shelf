# Firebase Cloud Functions Environment Variables
# IMPORTANT: This file should be in .gitignore and never committed to version control

# Gemini API Key for OCR Invoice Extraction
# Get from: https://aistudio.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# Stripe Secret Key
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs
# Get from: https://dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id_here
STRIPE_PYME_PRICE_ID=price_your_pyme_plan_id_here
