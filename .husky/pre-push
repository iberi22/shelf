#!/bin/sh

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR" || exit 1

echo "[pre-push] Building shelf-inventory (tsc + vite)..."
cd apps/shelf-inventory && pnpm run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "[pre-push] FAILED: shelf-inventory build failed. Fix before pushing."
  exit 1
fi
echo "[pre-push] OK: shelf-inventory build passed."

echo "[pre-push] Package unit tests (edge-mesh, p2p-mesh-core, gpu-agent)..."
cd "$ROOT_DIR" && pnpm run test:packages 2>&1
PKG_EXIT=$?
if [ $PKG_EXIT -ne 0 ]; then
  echo "[pre-push] FAILED: package unit tests. Fix before pushing."
  exit 1
fi
echo "[pre-push] OK: package unit tests passed."

echo "[pre-push] OK: All checks passed. Push allowed."
