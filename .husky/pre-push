#!/bin/sh

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR" || exit 1

echo "==================================================================="
echo "🚀 [pre-push] GitCore Quality Gate: Verifying safe deployment"
echo "==================================================================="

# 1. Production build
echo "📦 [1/4] Building shelf-inventory (Vite + TypeScript + PWA)..."
cd "$ROOT_DIR/apps/shelf-inventory" && pnpm run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FAILED: Build error in shelf-inventory."
  exit 1
fi
echo "✅ [1/4] Production build OK."

# 2. Unit tests for core packages
echo "🧪 [2/4] Running unit tests for packages (@shelf/edge-mesh, p2p-mesh-core, gpu-agent)..."
cd "$ROOT_DIR" && pnpm run test:packages 2>&1
PKG_EXIT=$?
if [ $PKG_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FAILED: Package unit tests failed."
  exit 1
fi
echo "✅ [2/4] Package unit tests OK."

# 3. E2E Mobile tests (graceful skip on NixOS / missing browser deps)
echo "📱 [3/4] Running E2E headless tests (Mobile Chrome)..."
cd "$ROOT_DIR" && pnpm --dir apps/shelf-inventory test:e2e:mobile 2>&1
MOBILE_EXIT=$?
if [ $MOBILE_EXIT -ne 0 ]; then
  # Check if failure is due to missing system libs (NixOS / headless env)
  if pnpm --dir apps/shelf-inventory test:e2e:mobile 2>&1 | grep -q "cannot open shared object file"; then
    echo "⚠️  [pre-push] SKIP: E2E Mobile skipped — missing browser system libraries (NixOS)."
    echo "   Unit tests and build passed. E2E requires Playwright browser deps."
    echo "   Run 'nix develop' or install deps before E2E testing."
    MOBILE_EXIT=0
  else
    echo "❌ [pre-push] FAILED: Mobile E2E tests failed."
    echo "👉 Check styles and mobile layout before production push."
    exit 1
  fi
fi
echo "✅ [3/4] Mobile E2E tests OK (or skipped)."

# 4. E2E Tablet tests
echo "🖥️  [4/4] Running E2E headless tests (Tablet)..."
cd "$ROOT_DIR" && pnpm --dir apps/shelf-inventory test:e2e:tablet 2>&1
TABLET_EXIT=$?
if [ $TABLET_EXIT -ne 0 ]; then
  if pnpm --dir apps/shelf-inventory test:e2e:tablet 2>&1 | grep -q "cannot open shared object file"; then
    echo "⚠️  [pre-push] SKIP: E2E Tablet skipped — missing browser system libraries (NixOS)."
    TABLET_EXIT=0
  else
    echo "❌ [pre-push] FAILED: Tablet E2E tests failed."
    echo "👉 Check tablet styles before production push."
    exit 1
  fi
fi
echo "✅ [4/4] Tablet E2E tests OK (or skipped)."

echo "==================================================================="
echo "✅ [pre-push] All gates passed (Build, Unit tests, E2E). Push authorized."
echo "==================================================================="
