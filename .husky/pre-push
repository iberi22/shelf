#!/bin/sh

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR" || exit 1

echo "==================================================================="
echo "🚀 [pre-push] GitCore Quality Gate: Verificando despliegue seguro"
echo "==================================================================="

# 1. Verificar Build de producción de la aplicación
echo "📦 [1/4] Compilando shelf-inventory (Vite + TypeScript + PWA)..."
cd "$ROOT_DIR/apps/shelf-inventory" && pnpm run build 2>&1
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FALLÓ: Error de compilación en shelf-inventory. Resuélvelo antes de hacer push."
  exit 1
fi
echo "✅ [1/4] Build de producción exitoso."

# 2. Verificar Tests Unitarios de los Paquetes Core P2P / Edge Mesh
echo "🧪 [2/4] Ejecutando tests unitarios de paquetes (@shelf/edge-mesh, p2p-mesh-core, gpu-agent)..."
cd "$ROOT_DIR" && pnpm run test:packages 2>&1
PKG_EXIT=$?
if [ $PKG_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FALLÓ: Pruebas unitarias de los paquetes no superadas."
  exit 1
fi
echo "✅ [2/4] Tests unitarios de paquetes exitosos."

# 3. Verificar Tests E2E Headless para Teléfonos (Mobile Chrome)
echo "📱 [3/4] Ejecutando pruebas E2E Headless para Teléfonos (Mobile Chrome)..."
cd "$ROOT_DIR" && pnpm --dir apps/shelf-inventory test:e2e:mobile 2>&1
MOBILE_EXIT=$?
if [ $MOBILE_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FALLÓ: Las pruebas responsivas de teléfonos no pasaron en modo headless."
  echo "👉 Revisa los estilos y layout móviles antes de subir a producción."
  exit 1
fi
echo "✅ [3/4] Pruebas E2E de Teléfonos pasaron correctamente."

# 4. Verificar Tests E2E Headless para Tablets
echo "🖥️  [4/4] Ejecutando pruebas E2E Headless para Tablets..."
cd "$ROOT_DIR" && pnpm --dir apps/shelf-inventory test:e2e:tablet 2>&1
TABLET_EXIT=$?
if [ $TABLET_EXIT -ne 0 ]; then
  echo "❌ [pre-push] FALLÓ: Las pruebas responsivas de tablets no pasaron en modo headless."
  echo "👉 Revisa los estilos en tablets antes de subir a producción."
  exit 1
fi
echo "✅ [4/4] Pruebas E2E de Tablets pasaron correctamente."

echo "==================================================================="
echo "✅ [pre-push] Todas las compuertas (Build, Unitarios, Móvil & Tablet) EXITOSAS. Push autorizado."
echo "==================================================================="
