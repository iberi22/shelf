#!/bin/sh

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR" || exit 1


echo "[pre-commit] Running lint-staged (Biome)..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm exec lint-staged
  LINT_EXIT=$?
else
  npx --no-install lint-staged
  LINT_EXIT=$?
fi
if [ $LINT_EXIT -ne 0 ]; then
  echo "[pre-commit] FAILED: lint-staged errors. Fix and retry."
  exit 1
fi
echo "[pre-commit] OK: lint-staged passed."

echo "[pre-commit] Running TypeScript type check (shelf-inventory)..."
cd "$ROOT_DIR/apps/shelf-inventory" && pnpm exec tsc --noEmit --pretty
TSC_EXIT=$?
if [ $TSC_EXIT -ne 0 ]; then
  echo "[pre-commit] FAILED: TypeScript type errors exist."
  exit 1
fi
echo "[pre-commit] OK: TypeScript check passed."

echo "[pre-commit] OK: All checks passed. Commit allowed."
