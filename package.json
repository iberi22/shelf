{
  "name": "shelf-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "vercel:pull:preview": "npx --yes vercel@latest pull --yes --environment=preview",
    "vercel:pull:production": "npx --yes vercel@latest pull --yes --environment=production",
    "vercel:build": "npx --yes vercel@latest build",
    "vercel:deploy:preview": "npx --yes vercel@latest deploy --prebuilt",
    "vercel:deploy:production": "npx --yes vercel@latest deploy --prebuilt --prod"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "chart.js": "^4.5.1",
    "cypress-downloadfile": "^1.2.4",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "cypress": "^15.7.1",
    "postcss": "^8.5.6",
    "rollup": "^4.59.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "rollup": "^4.59.0"
  }
}
