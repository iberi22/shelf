{
  "name": "shelf-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "vercel:pull:preview": "npx --yes vercel@latest pull --yes --environment=preview",
    "vercel:pull:production": "npx --yes vercel@latest pull --yes --environment=production",
    "vercel:build": "npx --yes vercel@latest build",
    "vercel:deploy:preview": "npx --yes vercel@latest deploy --prebuilt",
    "vercel:deploy:production": "npx --yes vercel@latest deploy --prebuilt --prod"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "chart.js": "^4.5.1",
    "cypress-downloadfile": "^1.2.4",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "cypress": "^15.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
