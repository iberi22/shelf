{
  "name": "shelf-app",
  "private": true,
  "version": "0.0.1-01-06-2026-10:31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "vercel:pull:preview": "pnpm dlx vercel@latest pull --yes --environment=preview",
    "vercel:pull:production": "pnpm dlx vercel@latest pull --yes --environment=production",
    "vercel:build": "pnpm dlx vercel@latest build",
    "vercel:deploy:preview": "pnpm dlx vercel@latest deploy --prebuilt",
    "vercel:deploy:production": "pnpm dlx vercel@latest deploy --prebuilt --prod",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "outdated": "pnpm outdated",
    "install:ci": "pnpm install --frozen-lockfile",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@mlc-ai/web-llm": "^0.2.83",
    "@noble/post-quantum": "^0.6.1",
    "chart.js": "^4.5.1",
    "cypress-downloadfile": "^1.2.4",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.14.2",
    "husky": "^8.0.3",
    "lint-staged": "17.0.7",
    "postcss": "^8.5.14",
    "rollup": "^4.59.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vercel": "^54.3.0",
    "vite": "^8.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "rollup": "^4.59.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "biome check --write"
    ]
  }
}
