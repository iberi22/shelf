{
  "name": "shelf-monorepo",
  "private": true,
  "version": "2.0.5",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test:packages": "pnpm --dir packages/edge-mesh test && pnpm --dir packages/p2p-mesh-core test && pnpm --dir packages/gpu-agent test",
    "peer-server": "peerjs --port 9000 --path / --allow_discovery --expire_timeout 60000 --alive_timeout 60000",
    "prepare": "husky",
    "release": "standard-version"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.24.0",
    "husky": "^9.1.7",
    "lint-staged": "17.2.0",
    "peer": "1.0.2",
    "standard-version": "^9.5.0",
    "turbo": "^2.10.7"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.11",
      "minimatch": "^10.2.3",
      "undici": "^6.27.0",
      "form-data": "^4.0.6",
      "ws": "^8.21.0",
      "protobufjs": "^7.6.1",
      "tmp": "^0.2.6",
      "esbuild": "^0.28.1",
      "smol-toml": "^1.6.1",
      "ajv": "^8.17.1",
      "qs": "^6.14.0",
      "dompurify": "^3.4.11",
      "js-yaml": "4.3.0",
      "@babel/core": "^7.26.0"
    }
  }
}
