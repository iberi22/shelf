{
  "name": "shelf-monorepo",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test:packages": "pnpm --dir packages/edge-mesh test && pnpm --dir packages/p2p-mesh-core test && pnpm --dir packages/gpu-agent test",
    "test": "pnpm test:packages",
    "peer-server": "peerjs --port 9000 --path / --allow_discovery --expire_timeout 60000 --alive_timeout 60000",
    "prepare": "husky",
    "release": "standard-version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "peer": "1.0.2",
    "standard-version": "^9.5.0",
    "turbo": "^2.11.9"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=6.2.1",
      "minimatch": ">=5.1.0",
      "undici": ">=6.19.0",
      "form-data": "^4.0.6",
      "ws": "^8.21.0",
      "protobufjs": "^7.6.1",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "tmp": "^0.2.6",
      "esbuild": "^0.28.2",
      "smol-toml": "^1.6.1",
      "ajv": "^8.17.1",
      "qs": "^6.14.0",
      "dompurify": ">=3.4.12",
      "js-yaml": "4.3.0",
      "@babel/core": "^7.26.0",
      "brace-expansion": ">=2.0.1",
      "node-forge": ">=1.3.1",
      "hono": ">=4.4.0"
    }
  }
}
