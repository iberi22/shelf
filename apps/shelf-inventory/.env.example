# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details
# Get these values from: https://console.firebase.google.com/ > Project Settings > General

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Google AI API Key for chat features
VITE_GOOGLE_AI_API_KEY=your-google-ai-api-key

# AdSense Configuration
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_DESKTOP_SLOT_ID=YYYYYYYYYY
VITE_ADSENSE_MOBILE_SLOT_ID=ZZZZZZZZZZ

# Xavier agentic memory (optional / offline-first)
# Namespace: app/shelf/instance/{instanceId} — see lib/xavier.ts
VITE_XAVIER_URL=http://localhost:8006
VITE_XAVIER_TOKEN=

# Supabase cloud backup sync (lib/cloudSync.ts — CloudSyncProvider)
# Get these from: Supabase > Project Settings > API
# Required table (run once in the SQL editor — SQL in lib/cloudSync.ts header):
#   cloud_sync (id text pk, user_id text, state text, updated_at timestamptz)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
