{
  "name": "shelf-inventory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "VITE_SKIP_LANDING=true VITE_TEST_MODE=true vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:test:2": "VITE_SKIP_LANDING=true VITE_TEST_MODE=true vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "vercel:pull:preview": "pnpm dlx vercel@latest pull --yes --environment=preview",
    "vercel:pull:production": "pnpm dlx vercel@latest pull --yes --environment=production",
    "vercel:build": "pnpm dlx vercel@latest build",
    "vercel:deploy:preview": "pnpm dlx vercel@latest deploy --prebuilt",
    "vercel:deploy:production": "pnpm dlx vercel@latest deploy --prebuilt --prod",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "outdated": "pnpm outdated",
    "install:ci": "pnpm install --frozen-lockfile",
    "prepare": "husky",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:sync": "playwright test tests/e2e/multi-node-sync.spec.ts",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:ct": "cypress run --component",
    "test": "pnpm test:unit && pnpm test:ct && pnpm test:e2e",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "e2e:ta": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "e2e:ta:live": "E2E_TELEMETRY_DISABLED=1 e2e run --target live"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@noble/post-quantum": "^0.7.1",
    "@sentry/browser": "^11.7.0",
    "@sentry/react": "^11.7.0",
    "@swal/inventory-core": "workspace:*",
    "@swal/ui": "github:iberi22/swal-ui",
    "chart.js": "^4.5.1",
    "cypress-downloadfile": "^1.2.4",
    "edge-mesh": "workspace:*",
    "edge-mesh-react": "workspace:*",
    "firebase": "13.0.0",
    "gpu-agent": "workspace:*",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.55.0",
    "p2p-mesh-core": "workspace:*",
    "peerjs": "^1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cypress/react": "^10.0.1",
    "@cypress/vite-dev-server": "^8.0.0",
    "@e2e-dev/web": "0.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "^10.6.1",
    "cypress": "^16.1.1",
    "e2e": "0.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "17.6.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "rollup": "^4.64.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^63.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "rollup": "^4.64.5"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json}": [
      "biome check --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.0"
    }
  }
}
